# Copy to .env and adjust. `pnpm dev`, `pnpm db:migrate`, `pnpm seed` and
# docker-compose.yml read it; variables set in your shell take precedence.
# Production does not read this file — set real environment variables there.

# ---- Required -------------------------------------------------------------
# Must be an ordinary role (NOSUPERUSER NOBYPASSRLS), or tenant isolation is off.
# This matches the `db` service in docker-compose.yml.
DATABASE_URL=postgres://crm_app:crm_app@localhost:5432/crm
# Signs the session cookie. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me

# ---- Local dev ports (pnpm dev) ------------------------------------------
API_PORT=5001
WEB_PORT=3210

# ---- Optional -------------------------------------------------------------
# Deployed URL, used for links in emails and Slack messages.
# APP_BASE_URL=https://crm.example.com
# Product name shown in emails.
# APP_NAME="Sirdab Revenue Engine"
# IANA time zone for date filters, "today" and report buckets (process-wide).
# APP_TIMEZONE=UTC
# Calling code without + (e.g. 44, 1, 966): phone search and import dedupe then
# treat 07700 900123 and +44 7700 900123 as the same number.
# PHONE_COUNTRY_CODE=
# Pino log level.
# LOG_LEVEL=info

# Email via any SMTP server (AWS SES, Postmark, Mailgun…). Without SMTP_HOST,
# sends are skipped. The defaults below deliver to Mailpit from
# `docker compose up -d` (inbox: http://localhost:8025). For a real provider set
# SMTP_PORT=587 (STARTTLS) or 465 (TLS), SMTP_USER/SMTP_PASSWORD, and remove
# SMTP_REQUIRE_TLS (it defaults to true).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_REQUIRE_TLS=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Sirdab Revenue Engine <no-reply@example.com>"

# Ask AI assistant. Without it the assistant is off.
# ANTHROPIC_API_KEY=

# Deal attachments, in any S3-compatible object storage (AWS S3, R2, MinIO…).
# The defaults below use the RustFS storage from `docker compose up -d`.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=crm-files
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin

# Error reporting. No-op when unset.
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# Inbound lead webhooks: owner for leads whose payload names no owner
# (falls back to the workspace's first active admin).
# WEBHOOK_DEFAULT_OWNER_EMAIL=

# Local dev only: capture Slack sends in memory (GET /api/dev/slack-outbox).
# SLACK_STUB=1

# First workspace + admin without the sign-up page (pnpm bootstrap).
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_WORKSPACE_NAME=
