# Copy to .env and fill in. Everything below "Optional" can stay empty: each
# integration switches itself off when its variables are unset.

# ---- Required ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/revenue_engine
# Signs session cookies. Use a long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me
# Public URL of the app, used for links in emails and Slack messages.
APP_BASE_URL=http://localhost:8080

# First admin account, created (or re-activated) by `pnpm --filter
# @workspace/api-server run bootstrap` and by the docker compose app service.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-strong-password
BOOTSTRAP_ADMIN_NAME=Administrator

# Frontend dev server only (`pnpm --filter @workspace/login run dev`).
PORT=5173
BASE_PATH=/

# ---- Optional: file attachments (any S3-compatible storage) -----------------
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ---- Optional: email (any SMTP provider) ------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Set to "false" only for a local catcher such as Mailpit.
SMTP_REQUIRE_TLS=true
MAIL_FROM="Sirdab Revenue Engine <no-reply@example.com>"

# ---- Optional: Slack ---------------------------------------------------------
# Bot token (xoxb-...) for posting to channels and DMs from automations.
# Scopes: chat:write, chat:write.public, im:write, users:read,
# users:read.email, channels:read, groups:read.
SLACK_BOT_TOKEN=
# Legacy incoming webhook (one fixed channel), used only without a bot token.
SLACK_WEBHOOK_URL=
# Channel for team announcements (won deals, new automations).
SLACK_ANNOUNCE_CHANNEL=
# Local dev only: capture Slack sends in memory (GET /api/dev/slack-outbox).
SLACK_STUB=

# ---- Optional: inbound lead webhook -----------------------------------------
# Owner for webhook-created deals when no assignment rule picks one.
WEBHOOK_DEFAULT_OWNER_EMAIL=

# ---- Optional: Pipedrive sync (migrations/pipedrive-api-sync) ---------------
PIPEDRIVE_API_TOKEN=

# ---- Optional: error tracking (Sentry) --------------------------------------
SENTRY_DSN=
# Same DSN, inlined into the frontend bundle at build time.
VITE_SENTRY_DSN=

LOG_LEVEL=info
