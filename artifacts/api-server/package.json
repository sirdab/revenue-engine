{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "seed": "pnpm run build && node --enable-source-maps ./dist/seed.mjs",
    "bootstrap": "pnpm run build && node --enable-source-maps ./dist/bootstrap.mjs",
    "migrate": "pnpm run build && MIGRATIONS_DIR=../../lib/db/drizzle node --enable-source-maps ./dist/migrate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --experimental-test-module-mocks --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@aws-sdk/client-s3": "catalog:",
    "@sentry/node": "catalog:",
    "@smithy/node-http-handler": "catalog:",
    "@workspace/api-zod": "workspace:*",
    "@workspace/automation-placeholders": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/deals-filter": "workspace:*",
    "@workspace/insights-spec": "workspace:*",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "multer": "catalog:",
    "nodemailer": "^9.0.1",
    "open-graph-scraper": "catalog:",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
