{
  // Typechecks the `node --test` files, which the main tsconfig excludes (they
  // import sibling modules with an explicit `.ts` extension so Node's native
  // type-stripping can resolve them without a bundler — allowed here via
  // allowImportingTsExtensions, which needs noEmit).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": []
}
