{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    "rootDir": "src",
    "skipLibCheck": true,
    "incremental": false,
    "composite": false,
    "allowImportingTsExtensions": false,
    "types": ["react", "react-dom", "node", "vite/client"]
  },
  "include": ["src/components/ui/**/*", "src/lib/**/*", "src/hooks/**/*"],
  "exclude": ["node_modules", "**/*.test.*"],
  "references": []
}
